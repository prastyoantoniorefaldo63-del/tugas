#include <iostream>
using namespace std;
int main() {
    string teks, nama[1];
    int total, tekan, porsi[1];
    int i;
   

    for(i=0;i<1;i++){
        cout<<"masukkan nama ";
        cin>>nama[i];
        cout<<"tekan 1 untuk nasi goreng tekan 2 untuk bakmi ";
        cin>>tekan;
        if(tekan==1){
            cout<<"oke kamu memilih bakmi dengan harga 1000 ";
            cout<<"silakan masukkan ingin memesan beapa porsi ";
            cin>>porsi[i];
            total=10000*porsi[i];
            }else if(tekan==2){
            cout<<"oke kamu memilih nasi goreng dengan harga 12000 ";
            cout<<"silakan masukkan ingin memesan beapa porsi ";
            cin>>porsi[i];
            total=12000*porsi[i];
            }
        }

    for(i=0;i<1;i++){
        cout<<"____________________"<<endl;
        cout<<"namanya adalah"<<endl;
        cout<<nama[i]<<endl;
        cout<<"memesan: ";
        if(tekan==1){
            cout<<"bakmi "<<endl;
            cout<<"total pesanan: ";
            cout<<porsi[i]<<endl;
            cout<<"harga: ";
            cout<<total;
        }else if(tekan==2){
            cout<<"nasi goreng "<<endl;
            cout<<"total pesanan: ";
            cout<<porsi[i]<<endl;
            cout<<"harga: ";
            cout<<total<<endl;
            cout<<"________________________";
        }
        
        
    }
    
    return 0;
}
